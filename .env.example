# ============================================
# Base Backend - Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Server
PORT=3000
NODE_ENV=development

# Authentication (REQUIRED)
JWT_SECRET=your_secret_key_at_least_32_characters_long
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=your_refresh_secret_key_at_least_32_characters_long
JWT_REFRESH_EXPIRE=30d
OTP_SENDER_NAME=Hệ thống TCNS
OTP_EXPIRE_MINUTES=10
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_RATE_LIMIT_ENABLED=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# Email OTP gateway
# OTP_EMAIL_API_URL=https://your-email-gateway/send
# OTP_EMAIL_API_TOKEN=your_email_gateway_token

# SMS OTP gateway
# OTP_SMS_API_URL=https://your-sms-gateway/send
# OTP_SMS_API_TOKEN=your_sms_gateway_token

# Storage keys
STORAGE_TOKEN_KEY=base_token
STORAGE_USER_KEY=base_user
STORAGE_REFRESH_TOKEN_KEY=base_refresh_token

# Database: json | mongodb
DB_CONNECTION=json

# MongoDB (required when DB_CONNECTION=mongodb)
# DATABASE_URL=mongodb://localhost:27017/base_backend

# Cloudinary (required for upload endpoints)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_FOLDER=tcns

# CORS
CORS_ORIGIN=*
CORS_CREDENTIALS=false
