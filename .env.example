# ============================================
# Base Backend - Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Server
PORT=3000
NODE_ENV=development

# Swagger Mode: 'manual' (swagger.js) or 'auto' (swagger-auto.js)
SWAGGER_MODE=auto

# Authentication (REQUIRED)
JWT_SECRET=your_secret_key_at_least_32_characters_long
JWT_EXPIRE=30d

# Storage keys (for frontend synchronization reference)
STORAGE_TOKEN_KEY=base_token
STORAGE_USER_KEY=base_user
STORAGE_REFRESH_TOKEN_KEY=base_refresh_token

# Database (uncomment when using MongoDB)
# DB_CONNECTION=mongodb
# DATABASE_URL=mongodb://user:password@host:port/database